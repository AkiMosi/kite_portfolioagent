{
  "_help": "Your screening thresholds. Every signal in the report is measured against these numbers; change them to match your own approach. Set a value to null to switch that check off. Sections: valuation/quality/growth/entry/market drive the screen signal; scoring drives the dashboard quant score and stance; risk drives the risk flags.",
  "fundamentals_max_age_days": 30,
  "valuation": {
    "max_pe": 40,
    "max_pe_vs_5y_median": 1.0,
    "max_peg": 1.5,
    "max_pb": 8
  },
  "quality": {
    "min_roe": 15,
    "min_roce": 15,
    "max_debt_to_equity": 1.0
  },
  "growth": {
    "min_sales_growth_3y": 8,
    "min_profit_growth_3y": 10
  },
  "entry": {
    "allowed_trends": ["Uptrend", "Recovering"],
    "pullback_band_pct": 3,
    "rsi_min": 35,
    "rsi_max": 60,
    "max_pct_above_sma50": 5,
    "require_above_sma200": false
  },
  "market": {
    "caution_when_nifty_downtrend": true
  },
  "scoring": {
    "trend_points": { "Uptrend": 30, "Recovering": 10, "Weakening": -15, "Downtrend": -30 },
    "above_sma200_points": 10,
    "below_sma200_points": -10,
    "rsi_overbought": 75,
    "rsi_overbought_points": -10,
    "rsi_oversold": 35,
    "rsi_oversold_points": -5,
    "rsi_normal_points": 5,
    "return_3m_divisor": 2,
    "return_3m_cap": 15,
    "verdict_points": { "pass": 10, "mixed": 0, "fail": -10 },
    "news_weight": 0.4,
    "stance_threshold": 0.25,
    "conflict_threshold": 0.2
  },
  "risk": {
    "large_position_pct": 10,
    "loss_vs_cost_pct": -20,
    "rsi_stretched": 75,
    "stale_fundamentals_days": 30
  },
  "exit": {
    "_help": "Exit planner: when and how much to sell. Sell-now triggers add up (capped at 100%). The stop is the nearest support below price, kept between min and max distance. Targets are a profit ladder on the shares left after the sell-now slice. null switches a rule off.",
    "min_profit_pct_for_trim": 5,
    "overbought_rsi": 75,
    "overbought_trim_pct": 25,
    "extended_pct_above_sma50": 15,
    "extended_trim_pct": 20,
    "fundamentals_fail_trim_pct": 25,
    "concentration_cap_pct": 10,
    "downtrend_sell_pct": 50,
    "deep_loss_pct": -20,
    "deep_loss_extra_pct": 25,
    "market_caution_trim_pct": 10,
    "min_stop_distance_pct": 3,
    "max_stop_distance_pct": 12,
    "stop_buffer_pct": 1,
    "profit_target_pcts": [10, 20],
    "ladder_sell_pcts": [25, 25]
  }
}
